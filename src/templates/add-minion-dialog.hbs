<div class="minion-dialog">
  <div class="form-group">
    <label>{{localize "COGSYNDICATE.MinionName"}}</label>
    <input type="text" name="name" value="{{minion.name}}" placeholder="{{localize 'COGSYNDICATE.MinionName'}}" />
  </div>
  <div class="form-group">
    <label>{{localize "COGSYNDICATE.MinionRole"}}</label>
    <input type="text" name="role" value="{{minion.role}}" placeholder="{{localize 'COGSYNDICATE.MinionRole'}}" />
  </div>
  <div class="form-group">
    <label>{{localize "COGSYNDICATE.MinionDescription"}}</label>
    <textarea name="description" placeholder="{{localize 'COGSYNDICATE.MinionDescription'}}">{{minion.description}}</textarea>
  </div>
</div>