<div class="{{cssClass}}">
  <header class="sheet-header flexrow">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" alt="{{item.name}}" />
    <h1 class="centered"><input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'COGSYNDICATE.Feats'}}" /></h1>
  </header>

  <section class="sheet-body">
    <div class="form-group">
      <label>{{localize systemFields.type.label}}</label>
      {{formInput systemFields.type value=system.type name="system.type"}}
    </div>
    <div class="form-group">
      <label>{{localize "COGSYNDICATE.Archetype"}}:</label>
      <div class="input-container">
        <select name="system.archetype.id">
          <option value="">-- {{localize "COGSYNDICATE.ArchetypeSelectDefault"}} --</option>
          {{#each availableArchetypes}}
          <option value="{{this._id}}" {{#if (eq ../system.archetype.id this._id)}}selected{{/if}}>{{this.name}}</option>
          {{/each}}
        </select>
      </div>
    </div>
    <div class="form-group">
      <label>{{localize "COGSYNDICATE.Description"}}:</label>
      <div class="input-container">
        <textarea name="system.effect" rows="4" placeholder="{{localize "COGSYNDICATE.Description"}}">{{system.effect}}</textarea>
      </div>
    </div>
  </section>
</div>